; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="FracturedExodus"
run/main_scene="uid://b61gt0cjd5c12"
config/features=PackedStringArray("4.6")
config/icon="res://icon.png"

[autoload]

Global="*res://behavior/global.gd"
Settings="*res://behavior/settings.gd"
Setup="*res://behavior/setup.gd"
Types="*res://behavior/types.gd"
WeaponRegister="*res://behavior/weapon_register.gd"
Local="*res://behavior/local.gd"
ClassRegister="*res://behavior/class_register.gd"
EquipmentRegister="*uid://2lfwy3jn5wvd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/size/fullscreen=true

[editor_plugins]

enabled=PackedStringArray("res://addons/SunshineClouds2/plugin.cfg", "res://addons/SunshineVolumetricClouds/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[global_group]

UI="UI elements"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

wav={
&"edit/loop_mode": 2
}

[physics]

3d/physics_engine="Jolt Physics"
common/enable_pause_aware_picking=true

[rendering]

quality/shadows/filter_mode=2

[shader_globals]

SunshineClouds_SunDirection={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
SunshineClouds_WindDirection={
"type": "vec2",
"value": Vector2(0, 0)
}

[steam]

initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4

[steam_server]

initialization/embed_callbacks=false
